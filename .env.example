# 首次部署时复制为 .env 并设置密码；.env 不提交到 Git。
# 国内默认使用 DaoCloud；其他网络环境可改为 public.ecr.aws/docker/library/postgres:16-alpine。
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
# 数据库迁移工具；备用来源为 flyway/flyway:13.10.0-alpine。
FLYWAY_IMAGE=docker.m.daocloud.io/flyway/flyway:13.10.0-alpine
POSTGRES_DB=rental
POSTGRES_USER=rental
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
