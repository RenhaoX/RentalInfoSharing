# 首次部署时复制为 .env 并设置密码；.env 不提交到 Git。
POSTGRES_DB=rental
POSTGRES_USER=rental
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
# IDEA 运行 AuthFlowTest 时使用的独立测试库端口，仅向本机开放。
AUTH_TEST_POSTGRES_PORT=5433
APP_PORT=8080

# 必填：生成至少32字节的随机密钥并Base64编码，不提交真实密钥。
# 生成方法见 docs/DOCKER_STARTUP.md；迁移或重建时保留原密钥。
AUTH_SIGNING_KEY=
AUTH_ISSUER=rental-info-sharing
AUTH_AUDIENCE=rental-info-sharing-api
AUTH_ACCESS_TOKEN_TTL=30m
AUTH_REFRESH_TOKEN_TTL=7d
# 前端来源白名单，逗号分隔；为空时不允许跨来源浏览器请求。
CORS_ALLOWED_ORIGINS=

# 默认使用 DaoCloud；其他网络环境可改为官方同版本镜像。
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
FLYWAY_IMAGE=docker.m.daocloud.io/flyway/flyway:13.10.0-alpine
MAVEN_IMAGE=docker.m.daocloud.io/library/maven:3.9.11-eclipse-temurin-21
JAVA_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:21.0.12.1_1-jre
