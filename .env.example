# 首次部署时复制为 .env 并设置密码；.env 不提交到 Git。
POSTGRES_DB=rental
POSTGRES_USER=rental
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
APP_PORT=8080

# 默认使用 DaoCloud；其他网络环境可改为官方同版本镜像。
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
FLYWAY_IMAGE=docker.m.daocloud.io/flyway/flyway:13.10.0-alpine
MAVEN_IMAGE=docker.m.daocloud.io/library/maven:3.9.11-eclipse-temurin-21
JAVA_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:21.0.12.1_1-jre
