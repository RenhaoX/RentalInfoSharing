<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rental</groupId>
        <artifactId>rental-info-sharing-workspace</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>rental-info-sharing-app</artifactId>
    <name>RentalInfoSharing App</name>
    <dependencies>
        <dependency>
            <groupId>com.rental</groupId>
            <artifactId>rental-info-sharing-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rental</groupId>
            <artifactId>rental-info-sharing-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rental</groupId>
            <artifactId>rental-info-sharing-rental</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>rental-info-sharing</finalName>
        <plugins>
            <!-- 只有 app 生成可执行包，其余模块保持普通 JAR。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
